# Create a free project at https://supabase.com then paste these.
# Until they are set, the studio stores the same tables in this browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Copilot Studio chat. Leave blank until a tenant can publish an agent.
# In Copilot Studio: Publish, then Channels, Mobile app, copy Token Endpoint.
VITE_COPILOT_TOKEN_ENDPOINT=
# Only if Microsoft says the agent lives in another region.
# VITE_COPILOT_DIRECTLINE_BASE=https://directline.botframework.com/v3/directline

# Claude API for the POC demo (university Copilot Studio cannot publish).
# Create a key at https://platform.claude.com → API keys.
# Keep this in .env only. Never commit it.
ANTHROPIC_API_KEY=
# Optional. Default is a cheap model for demos.
# ANTHROPIC_MODEL=claude-haiku-4-5
